# App
NODE_ENV=development
PORT=3000
# Comma-separated list of frontend origins allowed to call the API.
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Local PostgreSQL
# Replace YOUR_POSTGRES_PASSWORD with the password configured for your local
# PostgreSQL user. If the password contains @, :, /, ?, #, or %, URL-encode it.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/ecommerce_db
DATABASE_URL_TEST=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/ecommerce_test

# Set to true only when you need every SQL query printed in the terminal.
TYPEORM_LOGGING=false

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_secret

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# AWS / S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_PRODUCTS=your-products-bucket-name
S3_BUCKET_DOCUMENTS=your-documents-bucket-name
CLOUDFRONT_DOMAIN=https://xxxxxxxxxxxxxx.cloudfront.net

# Redis
# Optional in development and test. Required in production.
# REDIS_URL=redis://localhost:6379

# Business settings
VENDOR_ONBOARDING_FEE=5000
TAX_RATE=0.15
