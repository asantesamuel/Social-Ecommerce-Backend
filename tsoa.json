{
  "entryFile": "src/server.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/modules/**/*.controller.ts"],
  "spec": {
    "outputDirectory": "src/public",
    "specVersion": 3,
    "info": {
      "title": "E-Commerce API",
      "version": "1.0.0",
      "description": "E-Commerce REST API with JWT auth, Paystack payments, and vendor onboarding"
    },
    "securityDefinitions": {
      "jwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "handoffClient": {
        "type": "http",
        "scheme": "basic",
        "description": "Server-only dashboard client ID and secret"
      }
    }
  },
  "routes": {
    "routesDir": "src",
    "authenticationModule": "src/middlewares/authenticate",
    "iocModule": null,
    "middleware": "express",
    "bodyCoercion": true
  },
  "validator": "tsoa-validator"
}
